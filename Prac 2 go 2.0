package main

import (
	"bufio"
	"fmt"
	"os"
)

func main() {

	//es mejor usar scan que reader
	scanner := bufio.NewScanner(os.Stdin)

	//input de nombre
	fmt.Print("Introduce tu nombre completo por favor: ")
	scanner.Scan()
	name := scanner.Text()

	//input de edad
	var edad int
	fmt.Print("Introduce tu edad: ")
	fmt.Scanln(&edad)

	//input de metas profesinales
	fmt.Print("Introduce tu sueño o meta profesinoal: ")
	scanner.Scan()
	sueno := scanner.Text()

	//input de vivienda
	fmt.Print("Introduce donde vives (Ciudad y pais): ")
	scanner.Scan()
	place := scanner.Text()

	//mostrar mensaje
	fmt.Println("Hola,", name, ",tienes", edad, ",vives en", place, ",y tu meta es", sueno)
}
